# Optional but recommended: add your email to join Crossref's "polite pool".
# This raises the rate limit for search/list requests from 1/sec to 3/sec.
# Copy this file to .env.local and fill in your address.
VITE_CROSSREF_MAILTO=

# Optional: contact email for Unpaywall open-access PDF lookups (required by that API).
# Falls back to VITE_CROSSREF_MAILTO when unset; without either, the PDF lookup button is hidden.
VITE_UNPAYWALL_EMAIL=
